<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dive Into It</title>
  <link rel="stylesheet" href="/css/styles.css"> 
</head>
<body>
  <div id="scroll-widget"></div>
  <!-- TradingView Widget BEGIN -->
  <div class="tradingview-widget-container">
    <div class="tradingview-widget-container__widget"></div>
    <div class="tradingview-widget-copyright"><a href="https://www.tradingview.com/markets/" rel="noopener" target="_blank"><span class="blue-text">Markets today</span></a> by TradingView</div>
    <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js" async> 
      {
        "symbols": [
          {"proName": "FOREXCOM:SPXUSD", "title": "S&P 500"},
          {"description": "Nasdaq", "proName": "NASDAQ:QQQ"},
          {"description": "Russel 2000", "proName": "AMEX:IWM"},
          {"description": "Bitcoin", "proName": "BITSTAMP:BTCUSD"},
          {"description": "US Oil", "proName": "TVC:USOIL"},
          {"description": "Gold", "proName": "TVC:GOLD"},
          {"description": "Semi Conductors", "proName": "NASDAQ:SOXX"},
          {"description": "Apple", "proName": "NASDAQ:AAPL"},
          {"description": "Tesla", "proName": "NASDAQ:TSLA"},
          {"description": "Nvidia", "proName": "NASDAQ:NVDA"},
          {"description": "Amazon", "proName": "NASDAQ:AMZN"},
          {"description": "Dow Jones", "proName": "BLACKBULL:US30"},
          {"description": "US Dollar", "proName": "FX:USDOLLAR"}
        ],
        "showSymbolLogo": true,
        "colorTheme": "dark",
        "isTransparent": false,
        "displayMode": "adaptive",
        "locale": "en"
      }
    </script>
  </div>
  <!-- TradingView Widget END -->

  <div id = "scroller">
    <button id="scrollButton">Crypto</button>
  </div>


  <div id="container">
    <script type="module" src="/js/utils.js"></script>
    <script type="module" src="/js/horizontalBarGraph.js"></script>
    <script type="module" src="/js/barGraphManager.js"></script>
    <script type="module" src="/js/buttonManager.js"></script>
    <script type="module" src="/js/generateLabels.js"></script>
    <script type="module" src="/js/buttonWrapper.js"></script>
    
    <div class="button-stack">
      <button id="week" class="button-tab responsive-btn"><span class="text">Week</span></button>
      <button id="month" class="button-tab responsive-btn"><span class="text">Month</span></button>
      <button id="quarter" class="button-tab responsive-btn"><span class="text">Quarter</span></button>
    </div>  
    
    <div class="button-container">
      <button id="bonds" class="button-page responsive-btn"><span class="text">Bonds</span></button>
      <button id="sectors" class="button-page responsive-btn"><span class="text">Sectors</span></button>
      <button id="insiders" class="button-page responsive-btn"><span class="text">Insiders</span></button>
      <button id="options" class="button-page responsive-btn"><span class="text">Options</span></button>
      <button id="ratios" class="button-page responsive-btn"><span class="text">Ratios</span></button>
    </div> 

    <div class="dynamic-box-screen">
      <div class="bar-graph-display"></div>
    </div>
    
    <div class="label-container"></div>
    
    
    <div class="panel description-panel">
      <span class="text">
        This is an aggregation web tool. Data is pulled in through the Yahoo Finance API and a Python web scraping application. 
        Select a data set and perspective and this details page will be updated. 
        
        
      </span>
    </div> 
    
    <div class="panel specifics-panel">
      <span class="text">
        Make a bar graph selection and I will change to provide context 
      </span>
    </div> 

    <div class="web-scraper-love-letter">
      <div id="global-data" data-global-variable="<%= JSON.stringify(globalDataVariable) %>"></div>
    </div>
  </div>
<!-- Left-side Resources column -->
<aside class="resources">
  <h3>Resources</h3>
  <div class="resource-links">
    <a href="http://openinsider.com/" target="_blank" rel="noopener">
      <img src="assets/Open-Insider.JPG" alt="OpenInsider SEC Form 4">
    </a>
    <a href="https://finance.yahoo.com/" target="_blank" rel="noopener">
      <img src="assets/Yahoo-Finance.JPG" alt="Yahoo Finance">
    </a>
    <a href="https://www.stockninja.io/" target="_blank" rel="noopener">
      <img src="assets/Stock-Ninja.JPG" alt="StockNinja.io">
    </a>
  </div>
</aside>


</body>
</html>
